import torch

# --- 终极破解法：强制 PyTorch 允许加载所有对象 ---
# 保存原本的 torch.load
_original_load = torch.load

# 定义一个新函数，强制把 weights_only 设为 False
def _patched_load(*args, **kwargs):
    kwargs['weights_only'] = False
    return _original_load(*args, **kwargs)

# 替换掉系统默认的 load 函数
torch.load = _patched_load
# --------------------------------------------------

from emg2qwerty.lightning import ConformerCTCModule
from emg2qwerty.decoder import CTCGreedyDecoder

# 1. 加载模型 (请确认路径无误)
ckpt_path = r"D:\OneDrive\UCLA\Courses\247A Neural Networks and Deep Learning\Final Project\emg2qwerty\logs\2026-03-02\01-58-11\job0_model=conformer_ctc,module.depthwise_conv_kernel_size=15,module.hidden_size=64,module.num_heads=4,module.num_layers=6,trainer.devices=1,user=single_user\checkpoints\last.ckpt"

print("正在绕过安全检查加载模型...")
model = ConformerCTCModule.load_from_checkpoint(ckpt_path)
model.eval()
print("🎉 模型加载成功！")

# 2. 伪造输入数据进行预测 (Batch Size=1, Channels=528, TimeSteps=500)
dummy_input = torch.randn(1, 528, 500)
dummy_lengths = torch.tensor([500])

with torch.no_grad():
    print("正在进行前向传播...")
    
    # 修改这里：只传 dummy_input 一个参数
    outputs = model(dummy_input)
    
    # 兼容处理：有的模型返回 (logits, output_lengths)，有的直接返回 logits
    if isinstance(outputs, tuple) or isinstance(outputs, list):
        logits = outputs[0]
    else:
        logits = outputs
    
    # 使用 Greedy Decoder 解码
    decoder = CTCGreedyDecoder()
    predictions = decoder(logits)
    
    print("\n" + "="*40)
    print("🔍 模型实际预测出的字符串是：")
    print(f"'{predictions[0]}'")
    print("="*40)